{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": ["ES2020"],
    "types": ["miniprogram-api-typings"],
    "skipLibCheck": true
  },
  "include": ["miniprogram/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
