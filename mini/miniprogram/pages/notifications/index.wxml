<view class="page"
  ><view class="between page-heading"
    ><view class="title">桌边的消息。</view
    ><button wx:if="{{page.unread}}" class="link" disabled="{{busy}}" bindtap="readAll">全部已读</button></view
  ><view wx:if="{{error}}" class="error">{{error}}<button class="link" bindtap="load">重试</button></view
  ><view wx:for="{{page.items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"
    ><view class="subtitle">{{item.read_at ? '' : '● '}}{{item.title}}</view
    ><view class="memory">{{item.body}}</view></view
  ><view wx:if="{{loading}}" class="empty">正在加载…</view
  ><view wx:elif="{{!page.items.length && !error}}" class="empty">下一次相聚正在路上。</view></view
>
